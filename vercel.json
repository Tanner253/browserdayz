{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_SERVER_URL=https://browserdayz.onrender.com npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        }
      ]
    },
    {
      "source": "/assets/hdri/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/payouts",
      "destination": "/api/cashins"
    },
    {
      "source": "/changelog",
      "destination": "/changelog/index.html"
    },
    {
      "source": "/zona",
      "destination": "/index.html"
    },
    {
      "source": "/arena",
      "destination": "/index.html"
    },
    {
      "source": "/battleroyale",
      "destination": "/index.html"
    },
    {
      "source": "/br",
      "destination": "/index.html"
    },
    {
      "source": "/games-like-dayz",
      "destination": "/games-like-dayz/index.html"
    },
    {
      "source": "/free-fps-games",
      "destination": "/free-fps-games/index.html"
    },
    {
      "source": "/browser-battle-royale",
      "destination": "/browser-battle-royale/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "17 5 * * *"
    }
  ]
}
