{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zona-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "zona-server-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "--env-file=.env.local-server",
        "server/index.ts"
      ],
      "port": 8080
    },
    {
      "name": "zona-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
