{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zona-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "zona-sandbox",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5179",
        "--strictPort"
      ],
      "port": 5179
    },
    {
      "name": "zona-server-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "--env-file=.env.local-server",
        "server/index.ts"
      ],
      "port": 8080
    },
    {
      "name": "zona-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "zona-arena-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "arena/server.ts"
      ],
      "port": 8090
    },
    {
      "name": "zona-arena-film",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=tools/br-film/film.env",
        "--import",
        "tsx",
        "--import",
        "./tools/br-film/vclock.mjs",
        "arena/server.ts"
      ],
      "port": 8095
    }
  ]
}
