{
  "name": "browserdayz",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.api.json && vite build",
    "start": "node --import tsx server/index.ts",
    "preview": "vite preview",
    "assets": "node scripts/fetch-assets.mjs",
    "icons": "node scripts/icons.mjs",
    "character": "node scripts/build-character.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.api.json",
    "film": "node scripts/film.mjs",
    "test:bunker": "tsx test/bunker.test.ts",
    "test:daynight": "tsx test/daynight.test.ts",
    "test:payouts": "tsx test/solana.test.ts && tsx test/payouts.test.ts && tsx test/api.test.ts",
    "test:infected": "tsx test/infected.test.ts",
    "test:gas": "tsx test/gas.test.ts",
    "test:fires": "tsx test/fires.test.ts",
    "test:injury": "tsx test/injury.test.ts",
    "test:expansion": "tsx test/expansion.test.ts",
    "test:checks": "tsx test/checks.test.ts",
    "test:thirst": "tsx test/thirst.test.ts",
    "test:loot": "tsx test/loot.test.ts",
    "test:mags": "tsx test/mags.test.ts",
    "test:inventory": "tsx test/inventory.test.ts",
    "test:gunplay": "tsx test/gunplay.test.ts",
    "test:cars": "tsx test/cars.test.ts",
    "test:voice": "tsx test/voice.test.ts",
    "test:overlap": "tsx scripts/overlap-audit.ts",
    "test:news": "tsx test/news.test.ts && tsx test/news-http.test.ts",
    "test:breathe": "tsx test/breathe.test.ts",
    "test:death": "tsx test/death.test.ts",
    "treasury": "tsx scripts/treasury.ts",
    "sounds": "node scripts/sounds.mjs",
    "test:rules": "tsx test/bunker.test.ts && tsx test/cars.test.ts && tsx test/checks.test.ts && tsx test/daynight.test.ts && tsx test/expansion.test.ts && tsx test/fires.test.ts && tsx test/gas.test.ts && tsx test/gunplay.test.ts && tsx test/infected.test.ts && tsx test/injury.test.ts && tsx test/inventory.test.ts && tsx test/loot.test.ts && tsx test/mags.test.ts && tsx test/thirst.test.ts && tsx test/trade.test.ts && tsx test/voice.test.ts && tsx test/zone.test.ts"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@vercel/blob": "^2.8.1",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "meshoptimizer": "^1.3.0",
    "mp4-muxer": "^5.2.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
